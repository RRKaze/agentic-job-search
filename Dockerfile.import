FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /source
COPY src/ src/
COPY tests/AgenticJobSearch.ImportTestHost/ tests/AgenticJobSearch.ImportTestHost/
RUN dotnet publish src/AgenticJobSearch.Api -c Release -o /out/api
RUN dotnet publish tests/AgenticJobSearch.ImportTestHost -c Release -o /out/test

FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS integration-test
WORKDIR /app
COPY --from=build /out/test .
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=ImportIntegration
USER $APP_UID
ENTRYPOINT ["dotnet", "AgenticJobSearch.ImportTestHost.dll"]

FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS production
WORKDIR /app
COPY --from=build /out/api .
ENV ASPNETCORE_URLS=http://+:8080
USER $APP_UID
ENTRYPOINT ["dotnet", "AgenticJobSearch.Api.dll"]
